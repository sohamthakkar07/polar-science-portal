# Environment Configuration Example for PolarVerse
# Copy this file to .env and fill in any custom API keys or settings if needed.

# Application Port (Default: 3000)
VITE_PORT=3000

# Optional External API Keys (PolarVerse runs with built-in verified fallback data out-of-the-box)
# VITE_NASA_API_KEY=your_nasa_api_key_here
# VITE_NCPOR_API_KEY=your_ncpor_api_key_here
# VITE_MAP_TILE_PROVIDER_KEY=your_tile_key_here
